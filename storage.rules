rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function ownPath(userId) { return signedIn() && request.auth.uid == userId; }
    match /activity-photos/{userId}/{fileName} { allow read, write: if ownPath(userId); }
    match /location-submissions/{userId}/{fileName} { allow read: if signedIn(); allow write: if ownPath(userId); }
    match /contributor-documents/{userId}/{fileName} { allow read: if signedIn(); allow write: if ownPath(userId); }
  }
}
